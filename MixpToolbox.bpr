<?xml version='1.0' encoding='utf-8' ?>
<PROJECT>
  <MACROS>
    <VERSION value="BCB.06.00" />
    <PROJECT value="mixp-toolbox.exe" />
    <OBJFILES value="MixpToolbox.obj MainWindow.obj MenuRegistry.obj" />
    <RESFILES value="MixpToolbox.res" />
    <IDLFILES value="" />
    <IDLGENFILES value="" />
    <DEFFILE value="" />
    <RESDEPEN value="$(RESFILES)" />
    <LIBFILES value="" />
    <LIBRARIES value="" />
    <SPARELIBS value="" />
    <PACKAGES value="" />
    <PATHCPP value=".;src" />
    <PATHPAS value="." />
    <PATHRC value="." />
    <PATHASM value="." />
    <DEBUGLIBPATH value="$(BCB)\lib\debug" />
    <RELEASELIBPATH value="$(BCB)\lib\release" />
    <LINKER value="ilink32" />
    <USERDEFINES value="" />
    <SYSDEFINES value="_NO_VCL;WIN32;UNICODE;_UNICODE;WINVER=0x0501;_WIN32_WINNT=0x0501;_WIN32_IE=0x0501" />
    <MAINSOURCE value="MixpToolbox.cpp" />
    <INCLUDEPATH value=".;src;$(BCB)\include" />
    <LIBPATH value="$(BCB)\lib\obj;$(BCB)\lib;$(BCB)\lib\psdk" />
    <WARNINGS value="-w-par" />
  </MACROS>
  <OPTIONS>
    <IDLCFLAGS value="" />
    <CFLAG1 value="-O2 -H- -Vx -Ve -X- -a8 -b -c -tWM -tW" />
    <PFLAGS value="" />
    <RFLAGS value="" />
    <AFLAGS value="/mx /w2 /zd" />
    <LFLAGS value="-Tpe -x -Gn -v- -aa" />
  </OPTIONS>
  <LINKER>
    <ALLOBJ value="c0w32.obj $(OBJFILES)" />
    <ALLRES value="$(RESFILES)" />
    <ALLLIB value="$(LIBFILES) $(LIBRARIES) import32.lib cw32mt.lib" />
  </LINKER>
  <FILELIST><FILE FILENAME="MixpToolbox.cpp" FORMNAME="" UNITNAME="MixpToolbox" CONTAINERID="CCompiler" DESIGNCLASS="" LOCALCOMMAND="" /><FILE FILENAME="src\MainWindow.cpp" FORMNAME="" UNITNAME="MainWindow" CONTAINERID="CCompiler" DESIGNCLASS="" LOCALCOMMAND="" /><FILE FILENAME="src\MenuRegistry.cpp" FORMNAME="" UNITNAME="MenuRegistry" CONTAINERID="CCompiler" DESIGNCLASS="" LOCALCOMMAND="" /><FILE FILENAME="MixpToolbox.rc" FORMNAME="" UNITNAME="MixpToolbox" CONTAINERID="RCCompiler" DESIGNCLASS="" LOCALCOMMAND="" /></FILELIST><IDEOPTIONS>
[Version Info]
IncludeVerInfo=0
[Compiler]
ShowInfoMsgs=0
LinkDebugVcl=0
LinkCGLIB=0
[Parameters]
