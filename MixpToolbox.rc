#include <windows.h>
#include "src/resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_MAIN DIALOGEX 0, 0, 430, 285
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "MixP Toolbox"
FONT 9, "Tahoma"
BEGIN
    LTEXT "MixP Toolbox", IDC_HEADER, 6, 6, 218, 12
    PUSHBUTTON "Refresh", IDC_REFRESH, 226, 4, 43, 17
    PUSHBUTTON "New", IDC_NEW, 274, 4, 43, 17
    PUSHBUTTON "Delete", IDC_DELETE, 322, 4, 43, 17
    PUSHBUTTON "Export", IDC_EXPORT, 370, 4, 54, 17
    LTEXT "Scope", IDC_LABEL_SCOPE, 6, 26, 32, 12
    COMBOBOX IDC_SCOPE, 40, 24, 90, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Type", IDC_LABEL_EXT, 138, 26, 32, 12
    EDITTEXT IDC_EXTENSION, 174, 24, 40, 14, ES_AUTOHSCROLL
    LTEXT "Source", IDC_LABEL_VIEW, 224, 26, 42, 12
    COMBOBOX IDC_VIEW_SOURCE, 269, 24, 155, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Search", IDC_LABEL_SEARCH, 6, 44, 32, 12
    EDITTEXT IDC_SEARCH, 40, 42, 174, 14, ES_AUTOHSCROLL
    LTEXT "", IDC_EMPTY, 224, 41, 200, 20
    CONTROL "", IDC_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 6, 62, 418, 68
    EDITTEXT IDC_LOCATION, 6, 133, 418, 14, ES_AUTOHSCROLL | ES_READONLY
    LTEXT "Item ID", IDC_LABEL_VERB, 6, 152, 38, 12
    EDITTEXT IDC_VERB, 46, 150, 80, 14, ES_AUTOHSCROLL
    LTEXT "Name", IDC_LABEL_NAME, 132, 152, 38, 12
    EDITTEXT IDC_LABEL, 174, 150, 125, 14, ES_AUTOHSCROLL
    LTEXT "Source", IDC_LABEL_SOURCE, 305, 152, 35, 12
    COMBOBOX IDC_SOURCE, 344, 150, 80, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Program", IDC_LABEL_PROGRAM, 6, 172, 38, 12
    EDITTEXT IDC_PROGRAM, 46, 170, 318, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse", IDC_BROWSE, 370, 169, 54, 17
    LTEXT "Arguments", IDC_LABEL_ARGS, 6, 192, 38, 12
    EDITTEXT IDC_ARGUMENTS, 46, 190, 378, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "Edit full command", IDC_RAW, 46, 208, 122, 12
    AUTOCHECKBOX "Enabled", IDC_ENABLED, 174, 208, 36, 12
    AUTOCHECKBOX "Shift only", IDC_EXTENDED, 216, 208, 73, 12
    AUTOCHECKBOX "Environment variables", IDC_ENVIRONMENT, 294, 208, 130, 12
    LTEXT "Command", IDC_LABEL_COMMAND, 6, 227, 38, 12
    EDITTEXT IDC_COMMAND, 46, 225, 378, 24, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_HINT, 46, 251, 280, 12, SS_NOTIFY
    DEFPUSHBUTTON "Save", IDC_SAVE, 354, 249, 70, 18
    LTEXT "", IDC_STATUS, 6, 271, 418, 12, SS_PATHELLIPSIS | SS_NOTIFY
END

1 24 "resources\MixpToolbox.manifest"

1 VERSIONINFO
 FILEVERSION 0,1,2,0
 PRODUCTVERSION 0,1,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904e4"
  BEGIN
   VALUE "FileDescription", "MixP Toolbox - Context Menu Manager\0"
   VALUE "FileVersion", "0.1.2\0"
   VALUE "ProductName", "MixP Toolbox\0"
   VALUE "ProductVersion", "0.1.2\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1252
 END
END
