#include <windows.h>
#include "src/resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_MAIN DIALOGEX 0, 0, 560, 383
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "MixP Toolbox"
FONT 9, "Tahoma"
BEGIN
    LTEXT "MixP Toolbox", IDC_HEADER, 10, 8, 540, 14
    LTEXT "Scope", IDC_LABEL_SCOPE, 10, 30, 35, 12
    COMBOBOX IDC_SCOPE, 45, 28, 95, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Type", IDC_LABEL_EXT, 147, 30, 33, 12
    EDITTEXT IDC_EXTENSION, 180, 28, 45, 14, ES_AUTOHSCROLL
    LTEXT "Source", IDC_LABEL_VIEW, 234, 30, 33, 12
    COMBOBOX IDC_VIEW_SOURCE, 267, 28, 108, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Search", IDC_LABEL_SEARCH, 383, 30, 33, 12
    EDITTEXT IDC_SEARCH, 416, 28, 134, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Refresh", IDC_REFRESH, 10, 49, 53, 17
    PUSHBUTTON "New", IDC_NEW, 68, 49, 53, 17
    PUSHBUTTON "Delete", IDC_DELETE, 126, 49, 53, 17
    PUSHBUTTON "Export", IDC_EXPORT, 184, 49, 70, 17
    CONTROL "", IDC_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 10, 71, 540, 115
    LTEXT "", IDC_LOCATION, 10, 191, 540, 13, SS_PATHELLIPSIS
    LTEXT "Item ID", IDC_LABEL_VERB, 10, 213, 47, 12
    EDITTEXT IDC_VERB, 59, 211, 90, 14, ES_AUTOHSCROLL
    LTEXT "Name", IDC_LABEL_NAME, 159, 213, 40, 12
    EDITTEXT IDC_LABEL, 199, 211, 160, 14, ES_AUTOHSCROLL
    LTEXT "Source", IDC_LABEL_SOURCE, 368, 213, 42, 12
    COMBOBOX IDC_SOURCE, 412, 211, 138, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Program", IDC_LABEL_PROGRAM, 10, 235, 47, 12
    EDITTEXT IDC_PROGRAM, 59, 233, 432, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse", IDC_BROWSE, 497, 232, 53, 17
    LTEXT "Arguments", IDC_LABEL_ARGS, 10, 258, 47, 12
    EDITTEXT IDC_ARGUMENTS, 59, 256, 491, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "Edit full command", IDC_RAW, 59, 278, 180, 13
    LTEXT "Command", IDC_LABEL_COMMAND, 10, 299, 47, 12
    EDITTEXT IDC_COMMAND, 59, 297, 491, 24, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_HINT, 59, 325, 491, 20
    AUTOCHECKBOX "Enabled", IDC_ENABLED, 59, 349, 58, 13
    AUTOCHECKBOX "Shift only", IDC_EXTENDED, 125, 349, 90, 13
    AUTOCHECKBOX "Environment variables", IDC_ENVIRONMENT, 225, 349, 236, 13
    DEFPUSHBUTTON "Save", IDC_SAVE, 475, 347, 75, 20
    LTEXT "", IDC_STATUS, 10, 369, 540, 13, SS_PATHELLIPSIS
END

1 24 "resources\MixpToolbox.manifest"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904e4"
  BEGIN
   VALUE "FileDescription", "MixP Toolbox - Context Menu Manager\0"
   VALUE "FileVersion", "0.1.0\0"
   VALUE "ProductName", "MixP Toolbox\0"
   VALUE "ProductVersion", "0.1.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1252
 END
END
